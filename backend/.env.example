# Required
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrismart
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

# Frontend origin; use the exact deployed origin in production.
CLIENT_URL=http://localhost:5173

# Optional: cache and market-price synchronization
# REDIS_URL=redis://localhost:6379
# MARKET_CACHE_TTL_SECONDS=3600
# MARKET_SYNC_ENABLED=true

# Optional: email OTP delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# MAIL_FROM="AgriSmart <no-reply@example.com>"

# Optional: AI-assisted features. Set AI_PROVIDER to openai or gemini.
# AI_PROVIDER=gemini
# AI_API_KEY=your-provider-api-key
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-latest

# Optional: weather integration
# OPENWEATHER_API_KEY=your-openweather-api-key

# Required only when running `npm run db:seed` locally.
# SEED_ADMIN_EMAIL=admin@localhost
# SEED_ADMIN_PASSWORD=choose-a-local-password-with-12-or-more-characters
